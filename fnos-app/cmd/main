#!/bin/bash
set -u
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
CMD="${TRIM_APPDEST}/watchcow-r"
status() {
    [ -r "$PID_FILE" ] || return 1
    pid=$(cat "$PID_FILE")
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    [ "$(readlink "/proc/$pid/exe")" = "$(readlink -f "$CMD")" ]
}
case "${1:-}" in
start)
    status && exit 0
    rm -f "${TRIM_PKGVAR}/watchcow.sock"
    "$CMD" >> "$LOG_FILE" 2>&1 &
    echo "$!" > "$PID_FILE"
    # Migration may wait for the old watcher and restart the native Web service.
    for ((count=0; count<240; count++)); do
        status || { tail -n 12 "$LOG_FILE" >&2; exit 1; }
        [ -S "${TRIM_PKGVAR}/watchcow.sock" ] && exit 0
        sleep 1
    done
    echo "Watchcow_R 启动超时，请检查 $LOG_FILE" >&2
    exit 1
    ;;
stop)
    if status; then
        kill -TERM "$pid"
        for ((count=0; count<180; count++)); do
            status || break
            sleep 1
        done
        # Disable native routes before any forced stop.
        if status; then
            "$CMD" --mode disable || exit 1
            kill -KILL "$pid"
        fi
    fi
    "$CMD" --mode disable || exit 1
    rm -f "$PID_FILE"
    ;;
status)
    status && exit 0
    exit 3
    ;;
*) exit 1 ;;
esac
